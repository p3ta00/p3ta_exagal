# Exegol ZSH Configuration - mirrors host terminal setup
# This file is sourced in /root/.zshrc

# Disable Exegol's prompt hook so Starship can take over
add-zsh-hook -d precmd update_prompt

# ───────────────────────────────────────────────────────────────────
# PATH & ENV
# ───────────────────────────────────────────────────────────────────
export PATH="/opt/my-resources/bin:$PATH"
export TERM=xterm-256color
export EDITOR="nvim"

# ───────────────────────────────────────────────────────────────────
# PROMPT - Starship
# ───────────────────────────────────────────────────────────────────
if [ ! -f /root/.config/starship.toml ] && [ -f /opt/my-resources/setup/starship/starship.toml ]; then
    mkdir -p /root/.config
    cp /opt/my-resources/setup/starship/starship.toml /root/.config/starship.toml
fi
export STARSHIP_CONFIG=/root/.config/starship.toml

if command -v /opt/my-resources/bin/starship &> /dev/null; then
    eval "$(/opt/my-resources/bin/starship init zsh)"
fi

# ───────────────────────────────────────────────────────────────────
# MODERN CLI TOOLS
# ───────────────────────────────────────────────────────────────────

# Zoxide (better cd)
if command -v /opt/my-resources/bin/zoxide &> /dev/null; then
    eval "$(/opt/my-resources/bin/zoxide init zsh --cmd cd)"
fi

# Bat theme
export BAT_THEME="Dracula"

# FZF - Dracula theme
export FZF_DEFAULT_OPTS="--color=fg:#f8f8f2,bg:#282a36,hl:#bd93f9 --color=fg+:#f8f8f2,bg+:#44475a,hl+:#bd93f9 --color=info:#ffb86c,prompt:#50fa7b,pointer:#ff79c6 --color=marker:#ff79c6,spinner:#ffb86c,header:#6272a4"
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'

# Eza colors
export EZA_COLORS="da=1;34:gm=1;34"

# Delta
export DELTA_FEATURES="+side-by-side"

# ───────────────────────────────────────────────────────────────────
# ALIASES - FILE OPERATIONS
# ───────────────────────────────────────────────────────────────────

# Navigation
alias home='cd ~'
alias ..='cd ..'
alias ...='cd ../..'

# File listing (eza)
alias ls='/opt/my-resources/bin/eza --icons --group-directories-first'
alias ll='/opt/my-resources/bin/eza --icons --group-directories-first -l'
alias la='/opt/my-resources/bin/eza --icons --group-directories-first -la'
alias lt='/opt/my-resources/bin/eza --icons --group-directories-first --tree'
alias l='/opt/my-resources/bin/eza --icons --group-directories-first -F'

# File viewing (bat)
alias cat='/opt/my-resources/bin/bat --style=plain --paging=never'
alias catp='/opt/my-resources/bin/bat --style=full'

# Better replacements
alias fd='/opt/my-resources/bin/fd'
alias diff='/opt/my-resources/bin/delta'
alias top='/opt/my-resources/bin/btop'
alias rg='/opt/my-resources/bin/rg'

# ───────────────────────────────────────────────────────────────────
# ALIASES - UTILITIES
# ───────────────────────────────────────────────────────────────────

# Zellij
alias zj='/opt/my-resources/bin/zellij options --theme dracula'
alias zellij='/opt/my-resources/bin/zellij'
alias zellij-clean='zellij list-sessions --no-formatting | cut -d" " -f1 | xargs -I {} zellij delete-session {} --force'

# Yazi
alias yazi='/opt/my-resources/bin/yazi'

# Quick commands
alias h='history'
alias ports='netstat -tulanp'

# ───────────────────────────────────────────────────────────────────
# ALIASES - GIT
# ───────────────────────────────────────────────────────────────────
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'

# ───────────────────────────────────────────────────────────────────
# Zellij config sync
# ───────────────────────────────────────────────────────────────────
if [ -d /opt/my-resources/setup/zellij ] && [ ! -L /root/.config/zellij ]; then
    mkdir -p /root/.config
    rm -rf /root/.config/zellij
    ln -sf /opt/my-resources/setup/zellij /root/.config/zellij
fi

# ───────────────────────────────────────────────────────────────────
# Burp Suite Pro
# ───────────────────────────────────────────────────────────────────
if [ -d /opt/my-resources/setup/burp-config/burp ] && [ ! -d /root/.java/.userPrefs/burp ]; then
    mkdir -p /root/.java/.userPrefs
    cp -r /opt/my-resources/setup/burp-config/burp /root/.java/.userPrefs/burp
fi
alias burppro='/opt/my-resources/bin/BurpSuitePro/BurpSuitePro &> /dev/null &'

# ───────────────────────────────────────────────────────────────────
# ZSH HISTORY (shared across Zellij panes)
# ───────────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS

precmd_functions+=(_sync_history)
_sync_history() {
    fc -R
}

sync-history-widget() {
    fc -R
    zle reset-prompt
    zle -M "History synced"
}
zle -N sync-history-widget
bindkey '^H' sync-history-widget

# ───────────────────────────────────────────────────────────────────
# FUNCTIONS
# ───────────────────────────────────────────────────────────────────

mkcd() {
    mkdir -p "$1" && cd "$1"
}

extract() {
    if [ -f $1 ]; then
        case $1 in
            *.tar.bz2)   tar xjf $1     ;;
            *.tar.gz)    tar xzf $1     ;;
            *.bz2)       bunzip2 $1     ;;
            *.rar)       unrar e $1     ;;
            *.gz)        gunzip $1      ;;
            *.tar)       tar xf $1      ;;
            *.tbz2)      tar xjf $1     ;;
            *.tgz)       tar xzf $1     ;;
            *.zip)       unzip $1       ;;
            *.Z)         uncompress $1  ;;
            *.7z)        7z x $1        ;;
            *)           echo "'$1' cannot be extracted" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# ───────────────────────────────────────────────────────────────────
# Sliver C2 persistence
# ───────────────────────────────────────────────────────────────────
SLIVER_BACKUP="/opt/my-resources/setup/sliver"

if [ -d "$SLIVER_BACKUP/.sliver" ] && [ ! -d /root/.sliver ]; then
    cp -r "$SLIVER_BACKUP/.sliver" /root/.sliver
fi
if [ -d "$SLIVER_BACKUP/.sliver-client" ] && [ ! -d /root/.sliver-client ]; then
    cp -r "$SLIVER_BACKUP/.sliver-client" /root/.sliver-client
fi

_backup_sliver() {
    if [ -d /root/.sliver ] || [ -d /root/.sliver-client ]; then
        mkdir -p "$SLIVER_BACKUP"
        [ -d /root/.sliver ] && rsync -a --delete /root/.sliver/ "$SLIVER_BACKUP/.sliver/" 2>/dev/null
        [ -d /root/.sliver-client ] && rsync -a --delete /root/.sliver-client/ "$SLIVER_BACKUP/.sliver-client/" 2>/dev/null
    fi
}
add-zsh-hook zshexit _backup_sliver
