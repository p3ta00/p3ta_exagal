#!/bin/bash
# Save current Firefox profile to persistent storage
# Run this inside an Exegol container before stopping it
# (Only needed if the profile is NOT already symlinked)

GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

PERSISTENT_PROFILE="/opt/my-resources/setup/firefox/profile/.mozilla"

if [ -L /root/.mozilla ]; then
    echo -e "${GREEN}[+]${NC} Firefox profile is already symlinked — changes are saved automatically"
    exit 0
fi

echo -e "${BLUE}[*]${NC} Saving Firefox profile to my-resources..."
rm -rf "$PERSISTENT_PROFILE"
cp -a /root/.mozilla "$PERSISTENT_PROFILE"
echo -e "${GREEN}[+]${NC} Firefox profile saved"
